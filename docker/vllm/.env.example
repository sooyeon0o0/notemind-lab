# python3 ../init-env.py creates .env with a random API key.
VLLM_IMAGE=notemind/vllm-openai:v0.29.0-py314
VLLM_BASE_IMAGE=vllm/vllm-openai:v0.29.0
VLLM_USE_V2_MODEL_RUNNER=0
BIND_ADDRESS=127.0.0.1
NVIDIA_GPU_ID=0
CHAT_PORT=8000
EMBEDDING_PORT=8001
VLLM_API_KEY=
HF_TOKEN=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

# Starting candidates, NOT the finalized course models. Validate on the target GPU.
# AWQ is detected from the model configuration. Do not use MLX weights here.
CHAT_MODEL=Qwen/Qwen3-4B-AWQ
CHAT_MODEL_ID=notemind-chat
CHAT_MAX_MODEL_LEN=8192
CHAT_GPU_MEMORY_UTILIZATION=0.57
CHAT_MAX_NUM_SEQS=4
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_MODEL_ID=notemind-embedding
EMBEDDING_MAX_MODEL_LEN=2048
EMBEDDING_GPU_MEMORY_UTILIZATION=0.38
EMBEDDING_MAX_NUM_SEQS=4
